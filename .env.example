# Local development only. Copy to .env and keep it out of version control.
PORT=4100
DATABASE_URL=postgres://nefarec@127.0.0.1:5434/nefarec
# Any long random string. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Largest backup the server accepts, in megabytes.
MAX_BACKUP_MB=8
